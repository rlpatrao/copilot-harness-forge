{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "./run/ralph-loop.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/instinct-extractor.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/correction-detector.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/graph-refresh.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      }
    ]
  }
}
