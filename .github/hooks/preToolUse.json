{
  "preToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/dangerous-patterns.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/reminder-injector.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/e2e-gate.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/feature-edit-guard.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/rule-gate.js"
        }
      ]
    },
    {
      "matcher": "Read|Glob|Grep",
      "hooks": [
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/token-advisor.js"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/dangerous-patterns.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/reminder-injector.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/pre-bash-gate.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/token-advisor.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/rule-gate.js"
        }
      ]
    },
    {
      "matcher": "Agent|Task",
      "hooks": [
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/reminder-injector.js"
        },
        {
          "type": "command",
          "command": "COPILOT=1 node hooks/concurrency-gate.js"
        }
      ]
    }
  ]
}
