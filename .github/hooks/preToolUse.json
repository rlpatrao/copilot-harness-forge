{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "./run/dangerous-patterns.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/reminder-injector.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/e2e-gate.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/feature-edit-guard.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/rule-gate.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/token-advisor.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/pre-bash-gate.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "./run/concurrency-gate.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      }
    ]
  }
}
